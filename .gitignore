# Root .gitignore for NYBF Connect monorepo

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.js

# Next.js & Build outputs
.next/
frontend/.next/
out/
build/
dist/

# TypeScript caches
*.tsbuildinfo
tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Environment & Secrets
.env
.env*.local
*.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Database & SQLite files
*.db
*.sqlite
*.db-journal
*.sqlite-journal

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Coverage & Tests
coverage/
.nyc_output/
playwright-report/
test-results/

# Vercel & Turbo
.vercel/
.turbo/
